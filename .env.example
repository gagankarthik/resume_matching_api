# ── OpenAI (same account as the extraction engine) ──────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Vector store: "dynamodb" (default) or "opensearch" ───────────────────────
VECTOR_BACKEND=dynamodb
AWS_REGION=us-east-2

# DynamoDB backend
DDB_TABLE=oceanblue-resume-vectors
DDB_CACHE_TTL=300

# OpenSearch backend (only when VECTOR_BACKEND=opensearch)
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=resume-vectors
OPENSEARCH_SERVICE=aoss

# ── Matching knobs ───────────────────────────────────────────────────────────
MATCH_CANDIDATE_POOL=25
MATCH_RERANK_TOP=10
MATCH_SIM_WEIGHT=0.35
MATCH_LLM_WEIGHT=0.65

# ── Auth — shared secret the Ocean Blue app sends as X-API-Key ───────────────
API_KEY=change-me-to-a-long-random-string

# ── Existing extraction engine (for /ingest + backfill) ──────────────────────
RESUME_PARSER_URL=https://vsobqovdih6kgz2hk7suap4yw40fdhee.lambda-url.us-east-2.on.aws
RESUME_PARSER_TIMEOUT=120

# ── Misc ─────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
LOG_LEVEL=INFO
